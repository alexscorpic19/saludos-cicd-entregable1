# Ambiente de produccion (Gitflow: rama main)
# Solo valores NO sensibles. La password real de RDS vive en el servidor
# (~/saludos-backend.env) y/o en GitHub Secrets. Nunca se versiona.

APP_ENV=production

DB_HOST=<RDS_ENDPOINT>
DB_PORT=5432
DB_NAME=saludos
DB_USER=postgres
# DB_PASSWORD= **** no va aqui ****

BACKEND_HOST=<BACKEND_PRIVATE_IP>
BACKEND_PORT=5000
FRONTEND_PORT=8080
